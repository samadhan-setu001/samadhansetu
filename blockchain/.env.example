# ==============================================================================
# VeriCity Blockchain Configuration
# ==============================================================================

# Target Deployment Network: "local" or "amoy"
TARGET_NETWORK=local

# Localhost Node RPC (Used when running `npm run node`)
LOCAL_RPC_URL=http://127.0.0.1:8545

# Polygon Amoy Testnet RPC URL (Public RPC or Alchemy/Infura)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private Key of your deployer wallet (exported from MetaMask).
# For local testing, leave empty or use default Hardhat key.
# For Amoy testnet, paste your testnet private key (ensure it has Amoy POL).
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional: Polygonscan Amoy API key for verifying contracts
POLYGONSCAN_API_KEY=
